# Copie este arquivo para .env e preencha os segredos localmente.
# Nunca versione o arquivo .env preenchido.

DB_USERNAME=postgres
DB_NAME=dashboard_tcc
DB_PASSWORD=

# Portas publicadas no host. Altere se alguma já estiver em uso.
DB_PORT=5432
API_PORT=8080
FRONTEND_PORT=80

# Use pelo menos 32 bytes aleatorios. Exemplo: openssl rand -base64 48
JWT_SECRET=

# Origens autorizadas a chamar a API diretamente, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Limite total do processo Python, incluindo carregamento dos modelos e coleta.
MINING_PROCESS_TIMEOUT=PT15M

# Agendamento automático. Use false durante manutenção ou testes manuais.
MINING_SCHEDULE_ENABLED=true
MINING_SCHEDULE_INTERVAL=PT168H
MINING_SCHEDULE_RETRY_INTERVAL=PT24H
MINING_SCHEDULE_POLL_DELAY_MS=3600000
MINING_SCHEDULE_INITIAL_DELAY_MS=60000

# Escolha apify, serpapi ou browser. As chaves ficam somente no backend.
REVIEW_COLLECTOR_PROVIDER=apify
# Alternativa SerpApi: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=45
# false permite o cache da SerpApi (até 1 hora); true força uma consulta cobrada e atual.
SERPAPI_NO_CACHE=false
# Alternativa recomendada para coletar lotes completos de avaliações.
# Token em https://console.apify.com/account/integrations
APIFY_API_TOKEN=
APIFY_TIMEOUT_SECONDS=300
# Trava de segurança para impedir consumo inesperado em uma única execução.
APIFY_MAX_TOTAL_CHARGE_USD=1.0
# Para obter 100 comentários, consulta até 300 avaliações, pois muitas têm só estrelas.
APIFY_REVIEW_FETCH_MULTIPLIER=3
APIFY_MAX_RAW_REVIEWS=500
TARGET_REVIEWS=100

# Diretório que contém config, pesos e tokenizer do checkpoint treinado.
# Pode ser um caminho absoluto para uma versão baixada do armazenamento externo.
ABSA_MODEL_HOST_PATH=./minerador-py/artifacts/bertimbau-absa
# SHA-256 determinístico de todos os arquivos da versão publicada.
ABSA_MODEL_SHA256=
