# Copie este arquivo para .env e preencha os segredos localmente.
# Nunca versione o arquivo .env preenchido.

DB_USERNAME=postgres
DB_NAME=dashboard_tcc
DB_PASSWORD=

# Use pelo menos 32 bytes aleatorios. Exemplo: openssl rand -base64 48
JWT_SECRET=

# Diretório que contém config, pesos e tokenizer do checkpoint treinado.
# Pode ser um caminho absoluto para uma versão baixada do armazenamento externo.
ABSA_MODEL_HOST_PATH=./minerador-py/artifacts/bertimbau-absa
# SHA-256 determinístico de todos os arquivos da versão publicada.
ABSA_MODEL_SHA256=
