# Ignorar artefatos de build e cache locais
# para o contexto de build da API (raiz do projeto)

# Git
**/.git
**/.gitignore
**/.gitattributes

# IDE / editors
**/.vscode
**/.idea
**/*.iml

# Frontend — não precisa no build da API
dashboard-front/node_modules
dashboard-front/dist
dashboard-front/.next

# API — o build multi-stage compila o JAR a partir do código.
dashboard-api/target/

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
minerador-py/*.json
# O checkpoint ABSA é fornecido em runtime por um volume somente leitura.
minerador-py/artifacts/
# Avaliações reais e anotações científicas permanecem somente locais.
cientifico/dados_locais/

# Logs e temporários
**/*.log
**/logs

# Variaveis locais e segredos
.env
.env.*
**/.env
**/.env.*

# Docker próprio
**/docker-compose*.yml
**/.dockerignore

# OS
**/.DS_Store
**/Thumbs.db
